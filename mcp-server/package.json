{
  "name": "view-sim-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.itelo/view-sim",
  "description": "MCP server for view-sim: drives the browser extension, or renders devices headlessly with Playwright.",
  "license": "MIT",
  "author": "itelo",
  "homepage": "https://github.com/itelo/view-sim#mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itelo/view-sim.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/itelo/view-sim/issues"
  },
  "funding": "https://github.com/sponsors/itelo",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "responsive",
    "device",
    "simulator",
    "screenshot",
    "playwright",
    "claude"
  ],
  "type": "module",
  "bin": {
    "view-sim-mcp": "index.mjs"
  },
  "files": [
    "index.mjs",
    "headless.mjs",
    "render/",
    "vendor/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "playwright": "1.64.1"
  },
  "scripts": {
    "install-browsers": "playwright install chromium webkit",
    "prepack": "node scripts/vendor.mjs",
    "postpack": "node scripts/vendor.mjs clean"
  }
}
